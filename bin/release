#!/bin/sh
#
# 릴리스 한 번에: composer.json version 갱신 -> 검증 -> 커밋 -> 태그 -> 푸시
#
# 사용법: bin/release 4.1.0
#
# version 필드와 태그를 사람이 따로 만지면 어긋난다 (cms-orbit/core 4.0.8 사례).
# 이 스크립트가 둘을 한 동작으로 묶어 그 가능성을 없앤다.

set -e

version=$1

if [ -z "$version" ]; then
    printf '사용법: bin/release <version>   예: bin/release 4.1.0\n' >&2
    exit 1
fi

if ! printf '%s' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
    printf 'release: "%s" 는 x.y.z 형식이 아닙니다.\n' "$version" >&2
    exit 1
fi

cd "$(git rev-parse --show-toplevel)"

if [ -n "$(git status --porcelain)" ]; then
    printf 'release: 작업 트리가 깨끗하지 않습니다. 먼저 커밋하거나 stash 하세요.\n' >&2
    git status --short >&2
    exit 1
fi

branch=$(git rev-parse --abbrev-ref HEAD)

if git rev-parse -q --verify "refs/tags/$version" >/dev/null; then
    printf 'release: 태그 %s 가 이미 있습니다.\n' "$version" >&2
    exit 1
fi

# 1) version 필드를 태그와 동일하게 맞춘다
php -r '
    $file = "composer.json";
    $raw = file_get_contents($file);
    $data = json_decode($raw, true);
    if (!is_array($data)) {
        fwrite(STDERR, "release: composer.json 파싱 실패\n");
        exit(1);
    }
    if (!array_key_exists("version", $data)) {
        fwrite(STDERR, "release: composer.json 에 version 필드가 없습니다 — 확인 필요\n");
        exit(1);
    }
    // 들여쓰기·키 순서를 보존하기 위해 문자열 치환을 쓴다
    $pattern = "/(\"version\"\s*:\s*\")[^\"]*(\")/";
    $updated = preg_replace($pattern, "\${1}" . $argv[1] . "\${2}", $raw, 1);
    if ($updated === null || $updated === $raw && $data["version"] !== $argv[1]) {
        fwrite(STDERR, "release: version 필드 치환 실패\n");
        exit(1);
    }
    file_put_contents($file, $updated);
' "$version"

# 2) composer 스키마 검증
composer validate --no-check-publish --no-check-lock --quiet || {
    printf 'release: composer validate 실패\n' >&2
    git checkout -- composer.json
    exit 1
}

# 3) cms-orbit/* 의존이 Packagist 에 실제로 게시되어 있는지 확인.
#    core ^4.1 을 요구하면서 core 4.1.0 을 게시하지 않아 소비자 설치가
#    깨지는 사고를 막는다. ORBIT_PRIVATE_PACKAGES 에 나열된 것은 건너뛴다.
private_packages=${ORBIT_PRIVATE_PACKAGES:-cms-orbit/saas}

deps=$(php -r '
    $data = json_decode(file_get_contents("composer.json"), true);
    $self = $data["name"] ?? "";
    foreach (($data["require"] ?? []) as $name => $constraint) {
        if (str_starts_with($name, "cms-orbit/") && $name !== $self) {
            echo $name, "=", $constraint, "\n";
        }
    }
')

probe=$(mktemp -d)
trap 'rm -rf "$probe"' EXIT
problems=""

for dep in $deps; do
    name=${dep%%=*}
    constraint=${dep#*=}

    case ",$private_packages," in
        *",$name,"*)
            printf 'release: %s 는 비공개 패키지로 간주해 건너뜁니다.\n' "$name" >&2
            continue
            ;;
    esac

    rm -rf "$probe/check" && mkdir -p "$probe/check"
    printf '{"name":"orbit/release-probe","require":{}}' > "$probe/check/composer.json"

    # Composer 리졸버로 직접 확인한다. 자체 semver 구현을 두지 않는다.
    if ! (cd "$probe/check" && composer require --no-install --no-audit --no-scripts \
            --quiet "$name:$constraint" >/dev/null 2>&1); then
        published=$(composer show "$name" --all 2>/dev/null \
            | sed -n 's/^versions *: *//p' | cut -d, -f1 | tr -d ' *')
        problems="$problems\n  - $name $constraint 를 만족하는 게시 버전이 없습니다 (게시된 최신: ${published:-없음})"
    fi
done

if [ -n "$problems" ]; then
    printf 'release: 게시되지 않은 의존이 있어 소비자가 설치할 수 없습니다:' >&2
    printf '%b\n' "$problems" >&2
    git checkout -- composer.json
    exit 1
fi

# 4) 커밋 -> 태그 -> 푸시
git add composer.json

# version 이 이미 목표값이면 커밋할 게 없다 — 태그만 만든다.
if git diff --cached --quiet; then
    printf 'release: composer.json version 이 이미 %s 입니다. 태그만 만듭니다.\n' "$version"
else
    git commit -m "chore: release $version"
fi

git tag "$version"

printf '\nrelease: %s 준비 완료. 푸시합니다.\n' "$version"
git push origin "$branch"
git push origin "$version"

printf 'release: %s 푸시 완료.\n' "$version"
