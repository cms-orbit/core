{
    "name": "cms-orbit/core",
    "version": "4.0.7",
    "description": "CMS Orbit core: server-driven Screen/Layout/Field engine rendered via Inertia + React.",
    "keywords": [
        "laravel",
        "cms",
        "admin",
        "inertia",
        "react",
        "orbit"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.2",
        "composer/semver": "^3.0",
        "inertiajs/inertia-laravel": "^3.0",
        "intervention/image": "^3.0",
        "league/html-to-markdown": "^5.1",
        "geoip2/geoip2": "^3.0",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0",
        "laravel/scout": "^10.0 || ^11.0",
        "laravel/socialite": "^5.28",
        "socialiteproviders/apple": "^5.10",
        "socialiteproviders/kakao": "^4.3",
        "socialiteproviders/manager": "^4.9",
        "tabuna/breadcrumbs": "^4.0 || ^5.0 || ^6.0",
        "watson/active": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14"
    },
    "suggest": {
        "cms-orbit/sendgo": "Install for SendGo admin GUI, template sync, campaign records, and phone verification delivery."
    },
    "autoload": {
        "psr-4": {
            "CmsOrbit\\Core\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "CmsOrbit\\Core\\Foundation\\Providers\\FoundationServiceProvider"
            ],
            "aliases": {
                "Alert": "CmsOrbit\\Core\\Support\\Facades\\Alert",
                "Orbit": "CmsOrbit\\Core\\Support\\Facades\\Orbit"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "lock": false
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
